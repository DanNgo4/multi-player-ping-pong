{
  "name": "multi-player-ping-pong",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n next,party -c blue,magenta \"next dev\" \"partykit dev\"",
    "dev:next": "next dev",
    "dev:party": "partykit dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy:party": "partykit deploy"
  },
  "dependencies": {
    "next": "^16.2.11",
    "partysocket": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "chrome-devtools-mcp": "^1.1.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.2.11",
    "partykit": "^0.0.115",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
